pipeline {
    agent any
    environment {
        DOCKER_HUB_USERNAME = 'bansalshivani'
        BACKEND_IMAGE = "${DOCKER_HUB_USERNAME}/backend-app"
        FRONTEND_IMAGE = "${DOCKER_HUB_USERNAME}/frontend-app"
    }

    stages {
       
         stage('Build Backend Image') {
            steps {
                sh 'docker build -t $BACKEND_IMAGE ./Backend'
            }
        }
         stage('Build Frontend Image') {
            steps {
                sh 'docker build -t $FRONTEND_IMAGE ./Frontend/inventory_management_system'
            }
        }
         stage('Login to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    // Authenticate to the Docker Hub server
                    sh "echo ${DOCKER_PASS} | docker login -u ${DOCKER_USER} --password-stdin"
                }
            }
        }
         stage('Push Images') {
            steps {
                sh 'docker push $BACKEND_IMAGE'
                sh 'docker push $FRONTEND_IMAGE'
            }
        }
         stage('Trigger Downstream') {
            steps {
                // Triggers the job and blocks execution until it completes
                build 'CD'
            }
        }
    }
}
